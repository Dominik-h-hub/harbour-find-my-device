[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-find-my-device
Exec=sailfish-qml harbour-find-my-device
Name=Radar
Name[de]=Radar

[X-Sailjail]
# Sandboxed with stock permissions only (Harbour requirement):
#   Internet  - MQTT + map tiles
#   Location  - foreground GPS fix via QtPositioning
#   Audio     - ringtone preview in Settings
#   Downloads - staging the bundled daemon RPM for the sideload install flow
# Background daemons / privileged actions live in the separate (unsandboxed)
# harbour-find-my-device-daemon package; GUI <-> daemon coordination happens
# through the shared SQLite DB under the app data dir.
OrganizationName=harbour-find-my-device
ApplicationName=harbour-find-my-device
Permissions=Internet;Location;Audio;Downloads
